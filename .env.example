################################################################################
# ATSSS / ENVELOPE .env  (EDIT HERE FOR NEW TESTBED)
#
# Rule: Do NOT rename variables unless you also change the Python scripts.
# This file uses the exact env var names consumed by aue.py and ane.py.
################################################################################

################################################################################
# 0) IP MAP (EDIT THESE 4 FIRST)
################################################################################
APF_IP=
ANE_IP=
AUE_IP=
APP_SERVER_IP=

################################################################################
# 1) CONTROL-PLANE BASE URLS (used by aue.py / ane.py)
################################################################################
# AUE and ANE call APF using this base URL:
APF_BASE_URL=http://${APF_IP}:8100

# APF calls back into AUE / ANE using these callback URLs:
AUE_CALLBACK_URL=http://${AUE_IP}:8101/callback
ANE_CALLBACK_URL=http://${ANE_IP}:8102/callback

# Service ID used for subscription bookkeeping
SERVICE_ID=ATSSS

################################################################################
# 2) IDs (used in subscription payloads)
################################################################################
# aue.py and ane.py advertise themselves to APF with (ip,port) identity:
AUE_PORT=12345
ANE_PORT=12345

################################################################################
# 3) AUE (UE-side) runtime: spawn atsss_ue
################################################################################
ATSSS_UE_BIN=./atsss_project/build/atsss_ue

# UE sends data-plane traffic to ANE data ports (comma-separated):
ATSSS_SERVER_LIST=${ANE_IP}:4443,${ANE_IP}:4444

# Ultimate destination app server (your atsss_server listens UDP 4445):
ATSSS_DEST_APP_SERVER=${APP_SERVER_IP}:4445

# Interfaces used by UE dataplane (edit per testbed):
ATSSS_IFACES=<iface_name1>,<iface_name2>

# Default mode IDs (may be overridden by APF steering rules):
ATSSS_RTT_MODE_ID=1
ATSSS_LB_MODE_ID=2
ATSSS_SD_MODE_ID=3

# UE dataplane knobs
ATSSS_NUM_ITER=6000

# currently non-functioning, leave on 0
ATSSS_GOBACKN=0

# delay between iterations, higher = smaller throughput
ATSSS_INTERVAL_US=1000

ATSSS_SD_PARAM=100000

# difference in RTT between two paths that is large enough that it warrants a switch
ATSSS_RTT_PARAM=10000

# Optional behavior toggles
SKIP_N3IWUE=1
STRICT_N3IWUE=0
STOP_OLD_ON_NEW_SESSION=1

# GRE wait logic (optional; used by aue.py)
GRE_IFACE=<wifi_iface/GRE tunnel iface>
GRE_IP_PREFIX=
GRE_WAIT_TIMEOUT_S=15
GRE_WAIT_INTERVAL_S=1.0

################################################################################
# 4) ANE (Edge-side) runtime: spawn atsss_ane
################################################################################
ATSSS_ANE_BIN=./atsss_project/build/atsss_ane
ATSSS_ANE_PORTS=4443,4444
ATSSS_CERT=./atsss_project/build/server_cert.pem
ATSSS_KEY=./atsss_project/build/server_key.pem

# Ratio scaling used by ane.py when converting percent to "shares" (30% -> 3 if div=10)
RATIO_SCALE_DIV=10

################################################################################
# 5) ANE_RATIO_URL and AUE_RATIO_URL (used by atsss_ane/atsss_aue C binary ONLY if your ane_main.c reads it)
################################################################################
# If you changed/rebuilt atsss_ane to read ANE_RATIO_URL, point it to ANE's /ratio:
ANE_RATIO_URL=http://127.0.0.1:8102/ratio
AUE_RATIO_URL=http://127.0.0.1:8101/ratio

################################################################################
# 6) docker-compose substitution helpers (ONLY needed if your compose uses them)
################################################################################
# Your docker-compose.ane.yml used ${ANE_API_IP} for uvicorn --host:
ANE_API_IP=0.0.0.0
# If you have docker-compose.aue.yml similarly:
AUE_API_IP=0.0.0.0

################################################################################
# 7) RL agent ip and MPQUIC UE env variable
################################################################################
RL_RATIO_URL=http://localhost:5000/ratios
AUE_IP_PORT=${AUE_API_IP}:8101
# in microseconds
RL_REQUEST_RATE=5000000

################################################################################
# 8) DEBUG PRINTING
################################################################################
ENABLE_PRINT=ON


################################################################################
# 8) FIFO knobs
################################################################################
FIFO_READ_SIZE=1400

AUE_FIFO_OUTPUT=/tmp/fifo_output
AUE_FIFO_INPUT=/tmp/fifo_input

SERVER_FIFO_OUTPUT=/tmp/fifo_output
SERVER_FIFO_INPUT=/tmp/fifo_input
